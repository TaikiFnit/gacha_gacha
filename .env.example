# server 側が参照する環境変数。 docker-compose.yml と一致させる。
#
# 使い方: cp .env.example .env して必要なら値を書き換え、
#   起動前に  set -a; source .env; set +a  でシェルに読み込ませる。
PGHOST=localhost
PGPORT=5432
PGDATABASE=gacha
PGUSER=gacha
PGPASSWORD=gacha
APP_PORT=8000

# 本番でセッショントークンを署名する場合などに使う想定の予約。
# 本教材コードでは現在は参照していない (= 設定しても効果なし)。
# APP_SECRET=change-me-in-real-world
